---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getBlogs, parseTags } from '../../lib/api';
import type { BlogPost } from '../../lib/api';

const blogs: BlogPost[] = await getBlogs();
const tag = Astro.url.searchParams.get('tag') || '';

// 收集所有标签
const allTags = new Set<string>();
blogs.forEach((post) => {
  parseTags(post.tags).forEach((t) => allTags.add(t));
});
const tagList = Array.from(allTags).sort();

// 标签筛选
const filteredBlogs = tag
  ? blogs.filter((post) => parseTags(post.tags).includes(tag))
  : blogs;
---

<Layout title={tag ? `博客 - ${tag}` : '博客'} description="阅读我的博客文章">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <!-- Page Header -->
    <div class="mb-10">
      <h1 class="text-4xl font-bold text-text mb-3">博客</h1>
      <p class="text-text-secondary">
        {tag ? `标签: ${tag} · 共 ${filteredBlogs.length} 篇` : `共 ${filteredBlogs.length} 篇文章`}
      </p>
    </div>

    <!-- Tag Filter -->
    {tagList.length > 0 && (
      <div class="mb-10">
        <TagFilter tags={tagList} selectedTag={tag} />
      </div>
    )}

    <!-- Blog Grid -->
    {filteredBlogs.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {filteredBlogs.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 text-text-muted">
        <p class="text-lg mb-2">暂无相关文章</p>
        {tag && <a href="/blog" class="text-primary hover:underline text-sm">清除筛选</a>}
      </div>
    )}
  </div>
</Layout>
