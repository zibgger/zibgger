---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/constants';
import { getLatestBlogs, getFilteredPortfolios } from '../lib/api';
import type { BlogPost, PortfolioItem } from '../lib/api';

const blogs: BlogPost[] = await getLatestBlogs(3);
const portfolios: PortfolioItem[] = await getFilteredPortfolios(4);
---

<Layout title="首页" description={SITE_DESCRIPTION}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <!-- Background Decoration -->
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-20 left-10 w-72 h-72 bg-primary/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-accent/5 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-br from-primary/3 to-accent/3 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32 text-center">
      <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight">
        <span class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">
          {SITE_NAME}
        </span>
      </h1>
      <p class="text-lg md:text-xl text-text-secondary max-w-xl mx-auto mb-10 leading-relaxed">
        {SITE_DESCRIPTION}
      </p>
      <div class="flex items-center justify-center gap-4">
        <a
          href="/portfolio"
          class="px-6 py-3 rounded-full bg-primary text-white font-medium text-sm hover:bg-primary-dark transition-all duration-300 hover:shadow-lg hover:shadow-primary/25 hover:-translate-y-0.5"
        >
          查看作品集
        </a>
        <a
          href="/blog"
          class="px-6 py-3 rounded-full border border-bg-muted bg-bg-card text-text-secondary font-medium text-sm hover:border-primary/30 hover:text-primary transition-all duration-300 hover:-translate-y-0.5"
        >
          阅读博客
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blogs -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="text-3xl font-bold text-text mb-2">最新博客</h2>
        <p class="text-sm text-text-muted">记录思考与探索</p>
      </div>
      <a href="/blog" class="text-sm text-primary hover:text-primary-light transition-colors font-medium">
        查看全部 →
      </a>
    </div>

    {blogs.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {blogs.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-text-muted">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4 opacity-30">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        <p>暂无博客文章，请先在后台添加内容</p>
      </div>
    )}
  </section>

  <!-- Featured Portfolios -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="text-3xl font-bold text-text mb-2">精选作品</h2>
        <p class="text-sm text-text-muted">沉淀创作与项目</p>
      </div>
      <a href="/portfolio" class="text-sm text-primary hover:text-primary-light transition-colors font-medium">
        查看全部 →
      </a>
    </div>

    {portfolios.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {portfolios.map((item) => (
          <PortfolioCard item={item} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-text-muted">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4 opacity-30">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        </svg>
        <p>暂无作品集，请先在后台添加内容</p>
      </div>
    )}
  </section>

  <!-- CTA -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="glass-card rounded-3xl p-10 md:p-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-text mb-4">
        一起来创造吧
      </h2>
      <p class="text-text-secondary max-w-md mx-auto mb-8 leading-relaxed">
        如果你对我的作品感兴趣，或者想一起合作，欢迎随时联系我
      </p>
      <a
        href="/about"
        class="inline-block px-6 py-3 rounded-full bg-primary text-white font-medium text-sm hover:bg-primary-dark transition-all duration-300 hover:shadow-lg hover:shadow-primary/25"
      >
        了解更多
      </a>
    </div>
  </section>
</Layout>
