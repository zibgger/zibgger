---
interface Props {
  tags: string[];
  selectedTag: string;
  allLabel?: string;
}

const { tags, selectedTag, allLabel = '全部' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="flex flex-wrap gap-2">
  <a
    href={currentPath}
    class={`tag-btn px-4 py-2 text-sm font-medium rounded-full border transition-all duration-300 ${
      !selectedTag
        ? 'active bg-primary text-white border-primary shadow-lg shadow-primary/20'
        : 'bg-bg-card text-text-secondary border-bg-muted hover:border-primary/30 hover:text-primary'
    }`}
  >
    {allLabel}
  </a>
  {tags.map((tag) => (
    <a
      href={`${currentPath}?tag=${encodeURIComponent(tag)}`}
      class={`tag-btn px-4 py-2 text-sm font-medium rounded-full border transition-all duration-300 ${
        selectedTag === tag
          ? 'active bg-primary text-white border-primary shadow-lg shadow-primary/20'
          : 'bg-bg-card text-text-secondary border-bg-muted hover:border-primary/30 hover:text-primary'
      }`}
    >
      {tag}
    </a>
  ))}
</div>
