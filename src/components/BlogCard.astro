---
import { getImageUrl, parseTags } from '../lib/api';
import type { BlogPost } from '../lib/api';

const { post } = Astro.props;
const coverUrl = getImageUrl(post.cover);
const tags = parseTags(post.tags);
const date = new Date(post.publishedAt).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${post.slug}`} class="glass-card rounded-2xl overflow-hidden group block transition-all duration-300">
  <!-- Cover Image -->
  {coverUrl ? (
    <div class="relative h-48 overflow-hidden">
      <img
        src={coverUrl}
        alt={post.title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="h-48 bg-gradient-to-br from-primary/10 to-primary-light/10 flex items-center justify-center">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-primary/30">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
      </svg>
    </div>
  )}

  <!-- Content -->
  <div class="p-5">
    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-3">
        {tags.map((tag) => (
          <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-primary/8 text-primary">
            {tag}
          </span>
        ))}
      </div>
    )}

    <h3 class="text-lg font-semibold text-text mb-2 group-hover:text-primary transition-colors line-clamp-2">
      {post.title}
    </h3>

    {post.summary && (
      <p class="text-sm text-text-secondary leading-relaxed line-clamp-2 mb-3">
        {post.summary}
      </p>
    )}

    <time class="text-xs text-text-muted" datetime={post.publishedAt}>
      {date}
    </time>
  </div>
</a>
