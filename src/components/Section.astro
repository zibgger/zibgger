---
interface Props {
  title: string;
  subtitle?: string;
  className?: string;
}

const { title, subtitle, className = '' } = Astro.props;
---

<div class={`mb-10 ${className}`}>
  <h2 class="text-3xl font-bold text-text mb-2">{title}</h2>
  {subtitle && (
    <p class="text-text-muted text-sm">{subtitle}</p>
  )}
</div>
