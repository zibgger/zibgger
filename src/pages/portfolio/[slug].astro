---
import Layout from '../../layouts/Layout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import { getPortfolioBySlug, getPortfolioSlugs, getImageUrl } from '../../lib/api';
import { CATEGORY_LABELS } from '../../lib/constants';
import type { PortfolioItem } from '../../lib/api';

export async function getStaticPaths() {
  const slugs = await getPortfolioSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const item: PortfolioItem | null = await getPortfolioBySlug(slug!);

if (!item) {
  return Astro.redirect('/portfolio');
}

const categoryLabel = CATEGORY_LABELS[item.category] || item.category;
const date = new Date(item.publishedAt).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={item.title} description={item.title}>
  <article class="max-w-5xl mx-auto px-6 py-12">
    <!-- Image Gallery -->
    <div class="mb-10">
      <ImageGallery images={item.images} title={item.title} />
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto">
      <header class="mb-8">
        <div class="flex items-center gap-3 mb-3">
          <a
            href={`/portfolio?tag=${item.category}`}
            class="px-3 py-1 text-xs font-medium rounded-full bg-accent/10 text-accent hover:bg-accent/20 transition-colors"
          >
            {categoryLabel}
          </a>
          <time class="text-sm text-text-muted" datetime={item.publishedAt}>{date}</time>
        </div>

        <h1 class="text-3xl md:text-4xl font-bold text-text mb-4">
          {item.title}
        </h1>
      </header>

      {item.description && (
        <div class="rich-content">
          <Fragment set:html={item.description} />
        </div>
      )}

      <div class="mt-16 pt-8 border-t border-bg-muted">
        <a
          href="/portfolio"
          class="inline-flex items-center gap-2 text-sm text-primary hover:text-primary-light transition-colors font-medium"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          返回作品集
        </a>
      </div>
    </div>
  </article>
</Layout>
