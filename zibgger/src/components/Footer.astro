---
import { SITE_NAME } from '../lib/constants';
---

<footer class="bg-text text-bg py-16 mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div>
        <h3 class="text-xl font-bold text-white mb-3">{SITE_NAME}</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          记录思考，沉淀创作。<br />探索设计与技术的无限可能。
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-semibold text-accent uppercase tracking-wider mb-4">快速链接</h4>
        <div class="flex flex-col gap-2">
          <a href="/" class="text-sm text-text-muted hover:text-accent transition-colors">首页</a>
          <a href="/blog" class="text-sm text-text-muted hover:text-accent transition-colors">博客</a>
          <a href="/portfolio" class="text-sm text-text-muted hover:text-accent transition-colors">作品集</a>
          <a href="/about" class="text-sm text-text-muted hover:text-accent transition-colors">关于</a>
        </div>
      </div>

      <!-- Social -->
      <div>
        <h4 class="text-sm font-semibold text-accent uppercase tracking-wider mb-4">联系方式</h4>
        <div class="flex gap-4">
          <a href="https://github.com" target="_blank" rel="noopener noreferrer"
             class="w-10 h-10 flex items-center justify-center rounded-lg bg-text-secondary/20 hover:bg-accent/20 transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-text-muted hover:text-accent transition-colors">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href="mailto:hello@example.com"
             class="w-10 h-10 flex items-center justify-center rounded-lg bg-text-secondary/20 hover:bg-accent/20 transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-muted hover:text-accent transition-colors">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-text-secondary/20 mt-10 pt-6 text-center">
      <p class="text-xs text-text-muted">
        &copy; {new Date().getFullYear()} {SITE_NAME}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
