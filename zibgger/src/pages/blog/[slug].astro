---
import Layout from '../../layouts/Layout.astro';
import { getBlogBySlug, getBlogSlugs, getImageUrl, parseTags } from '../../lib/api';
import type { BlogPost } from '../../lib/api';
import { STRAPI_BASE_URL } from '../../lib/constants';

export async function getStaticPaths() {
  const slugs = await getBlogSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post: BlogPost | null = await getBlogBySlug(slug!);

if (!post) {
  return Astro.redirect('/blog');
}

const coverUrl = getImageUrl(post.cover);
const tags = parseTags(post.tags);
const date = new Date(post.publishedAt).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={post.title} description={post.summary || post.title}>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <!-- Cover Image -->
    {coverUrl && (
      <div class="relative h-64 md:h-96 rounded-2xl overflow-hidden mb-10">
        <img
          src={coverUrl}
          alt={post.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- Header -->
    <header class="mb-10">
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => (
            <a
              href={`/blog?tag=${encodeURIComponent(tag)}`}
              class="px-3 py-1 text-xs font-medium rounded-full bg-primary/8 text-primary hover:bg-primary/15 transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      <h1 class="text-3xl md:text-4xl font-bold text-text mb-4 leading-tight">
        {post.title}
      </h1>

      <div class="flex items-center gap-4 text-sm text-text-muted">
        <time datetime={post.publishedAt}>{date}</time>
      </div>
    </header>

    <!-- Content -->
    <div class="rich-content">
      <Fragment set:html={post.content} />
    </div>

    <!-- Footer -->
    <div class="mt-16 pt-8 border-t border-bg-muted">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-primary hover:text-primary-light transition-colors font-medium"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        返回博客列表
      </a>
    </div>
  </article>
</Layout>
