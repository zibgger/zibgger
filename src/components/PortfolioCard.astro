---
import { getImageUrl } from '../lib/api';
import { CATEGORY_LABELS } from '../lib/constants';
import type { PortfolioItem } from '../lib/api';

const { item } = Astro.props;
const firstImage = item.images?.[0];
const imageUrl = getImageUrl(firstImage || null);
const categoryLabel = CATEGORY_LABELS[item.category] || item.category;
---

<a href={`/portfolio/${item.slug}`} class="glass-card rounded-2xl overflow-hidden group block transition-all duration-300">
  <!-- Image -->
  <div class="relative h-56 overflow-hidden">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={item.title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-accent/10 to-primary/10 flex items-center justify-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent/30">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
    )}
    <!-- Category Badge -->
    <span class="absolute top-3 left-3 px-2.5 py-1 text-xs font-medium rounded-full bg-bg/80 backdrop-blur-sm text-primary border border-bg-muted">
      {categoryLabel}
    </span>
    {item.images && item.images.length > 1 && (
      <span class="absolute top-3 right-3 px-2 py-1 text-xs font-medium rounded-full bg-bg/80 backdrop-blur-sm text-text-secondary">
        +{item.images.length} 张
      </span>
    )}
  </div>

  <!-- Content -->
  <div class="p-5">
    <h3 class="text-lg font-semibold text-text group-hover:text-primary transition-colors">
      {item.title}
    </h3>
  </div>
</a>
