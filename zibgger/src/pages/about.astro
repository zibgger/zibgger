---
import Layout from '../layouts/Layout.astro';

const skills = [
  'TypeScript', 'React', 'Next.js', 'Astro', 'Vue.js',
  'Node.js', 'Python', 'Tailwind CSS', 'GraphQL', 'Docker',
  'Figma', 'UI/UX Design', 'Git', 'CI/CD',
];

const experiences = [
  {
    year: '2023 - 至今',
    title: '高级前端工程师',
    company: '某科技公司',
    description: '负责核心产品前端架构设计与开发，推动组件库建设和前端工程化体系落地。',
  },
  {
    year: '2021 - 2023',
    title: '前端开发工程师',
    company: '某互联网公司',
    description: '参与多个项目的前端开发，主攻 React 生态和性能优化，积累了丰富的实战经验。',
  },
  {
    year: '2019 - 2021',
    title: '全栈开发工程师',
    company: '某创业公司',
    description: '从零到一搭建产品的前后端架构，深度参与产品设计和用户增长。',
  },
];
---

<Layout title="关于" description="了解更多关于我的信息">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <!-- Profile -->
    <div class="text-center mb-16">
      <!-- Avatar -->
      <div class="w-32 h-32 mx-auto mb-6 rounded-full bg-gradient-to-br from-primary to-accent p-1">
        <div class="w-full h-full rounded-full bg-bg-card flex items-center justify-center text-4xl font-bold text-primary">
          Q
        </div>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-text mb-3">关于我</h1>
      <p class="text-text-secondary max-w-lg mx-auto leading-relaxed">
        一名热爱技术与设计的前端工程师，专注于创造优雅、高效的数字体验。
        在代码与视觉的交汇处寻找灵感。
      </p>
    </div>

    <!-- Skills -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-text mb-6">技能 & 工具</h2>
      <div class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="px-4 py-2 text-sm font-medium rounded-full bg-bg-card border border-bg-muted text-text-secondary hover:border-primary/30 hover:text-primary transition-all duration-300 cursor-default">
            {skill}
          </span>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-text mb-8">工作经历</h2>
      <div class="space-y-8">
        {experiences.map((exp) => (
          <div class="glass-card rounded-2xl p-6 transition-all duration-300">
            <span class="inline-block px-3 py-1 text-xs font-medium rounded-full bg-primary/8 text-primary mb-3">
              {exp.year}
            </span>
            <h3 class="text-lg font-semibold text-text mb-1">{exp.title}</h3>
            <p class="text-sm text-accent mb-3">{exp.company}</p>
            <p class="text-sm text-text-secondary leading-relaxed">{exp.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section>
      <h2 class="text-2xl font-bold text-text mb-6">联系方式</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="mailto:hello@example.com"
          class="glass-card rounded-2xl px-6 py-4 flex items-center gap-3 hover:shadow-lg transition-all duration-300 group"
        >
          <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary/10 group-hover:bg-primary/20 transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <span class="text-sm font-medium text-text-secondary group-hover:text-primary transition-colors">
            hello@example.com
          </span>
        </a>

        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="glass-card rounded-2xl px-6 py-4 flex items-center gap-3 hover:shadow-lg transition-all duration-300 group"
        >
          <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-text/5 group-hover:bg-text/10 transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-text">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <span class="text-sm font-medium text-text-secondary group-hover:text-text transition-colors">
            GitHub
          </span>
        </a>
      </div>
    </section>
  </div>
</Layout>
